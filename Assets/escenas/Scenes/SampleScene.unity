  m_Script: {fileID: 11500000, guid: 3101f7ea813d5c0439ba6085457b8466, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoNPC
  panelDialogo: {fileID: 1247554091}
  textoDialogo: {fileID: 445560062}
  textoNombre: {fileID: 1976549280}
  panelRespuesta: {fileID: 852564270}
  botonSi: {fileID: 673329059}
  botonNo: {fileID: 1656236843}
  escenaBatalla: TutorialScene
  nombreNPC: Aldeano
  frases:
  - "Bienvenido, joven mago... Hac\xEDa mucho tiempo que no ve\xEDa a alguien cruzar
    estas tierras."
  - "Este es el mundo de Wizard102. Un lugar donde la magia lo gobierna todo... y
    donde el peligro acecha en cada rinc\xF3n."
  - Grandes criaturas rondan los bosques. Hechiceros corruptos dominan las torres
    del norte. Y antiguos secretos esperan ser descubiertos bajo estas piedras.
  - "Pero tambi\xE9n hay esperanza. Magos valientes, aliados poderosos... y un destino
    que quiz\xE1s t\xFA mismo a\xFAn no comprendes."
  - "He visto muchos aventureros pasar por aqu\xED. Pocos estaban preparados. Menos
    a\xFAn regresaron con gloria."
  - "\xBFDeseas iniciar un peque\xF1o tutorial antes de adentrarte en la aventura?"
  velocidadEscritura: 0.04
  distanciaInteraccion: 3
  teclaInteraccion: 101
  indicadorE: {fileID: 1033195778}
